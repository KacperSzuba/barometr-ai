# Środowisko
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# Serwer
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Modele lokalne
EMBEDDING_MODEL_NAME=sdadas/mmlw-retrieval-roberta-large
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Zewnętrzne LLM (Warstwa L3 Kaskady Kosztowej)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Budżet i Limity Tokenów
DAILY_TOKEN_BUDGET=1000000
COST_ALERT_THRESHOLD=0.8

# Telemetria (OpenTelemetry)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=barometr-ai
