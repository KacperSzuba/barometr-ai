# Środowisko
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# Serwer
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Warstwa L1 — lokalne embeddingi (koszt zerowy)
# Model musi być obsługiwany przez fastembed: TextEmbedding.list_supported_models()
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
# Zmiana modelu = przeliczenie całego indeksu pgvector po stronie backendu
EMBEDDING_MODEL_VERSION=multilingual-e5-large@v1

# Warstwa L3 — model generatywny (Claude API)
# Pusty klucz w dev = degradacja do adaptera heurystycznego (raportuje się jako heuristic-v0).
# Przy APP_ENV=production pusty klucz wywraca start serwisu.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_REGENERATION_ATTEMPTS=2

# Budżet i limity tokenów
DAILY_TOKEN_BUDGET=1000000
COST_ALERT_THRESHOLD=0.8
# memory = licznik w pamięci procesu; wymusza WORKERS=1 i jedną replikę, bo każdy proces
# liczyłby osobno, dając limit N × DAILY_TOKEN_BUDGET. Start z WORKERS>1 jest wtedy odrzucany.
# redis = licznik współdzielony; warunek skalowania poziomego. Wymaga `uv sync --extra redis`.
TOKEN_BUDGET_BACKEND=memory
REDIS_URL=

# Telemetria (OpenTelemetry)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=barometr-ai
